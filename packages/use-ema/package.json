{
  "name": "@prism-shadow/use-ema",
  "version": "0.1.0",
  "description": "Penguin Workbench guiding users to create lifelong AI companions using EverMemoryArchive (@prism-shadow/ema).",
  "author": "Ema Fan Club",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/module.js",
  "types": "./dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./manifest": "./manifest.json"
  },
  "files": [
    "manifest.json",
    "module.ts",
    "dist",
    "ui",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prism-shadow/ema": "workspace:*",
    "smol-toml": "^1.9.1"
  },
  "penguin": {
    "version": "2026.10.26.1",
    "modules": [
      {
        "name": "Workbench",
        "requires": {
          "host": {
            "iface": "@prismshadow/penguin-server#WorkbenchHost",
            "from": "Host"
          }
        },
        "provides": {
          "main": "@prismshadow/penguin-server#WorkbenchMain"
        },
        "contributes": {
          "WebModule.sessionTabs": [
            {
              "id": "use_ema.main",
              "key": "use-ema",
              "title": "Use EMA",
              "titleZh": "使用 EMA",
              "renderer": {
                "iframe": {
                  "src": "ui/index.html"
                }
              }
            }
          ]
        }
      }
    ]
  }
}
