#!/usr/bin/env bash
set -euo pipefail

REAL_BWRAP="/home/rei/.penguin/data/plugins/node_modules/@penguinharness/sandbox-bwrap/vendor/linux-x64/bin/bwrap"
HOME_DIR="/home/rei"
GLOBAL_CONFIG="$HOME_DIR/.penguin/data/ema/config.toml"
SANDBOX_PROFILE="$HOME_DIR/.penguin/data/shell-startup/sandbox-profile"

has_arg_seq() {
  local a="$1" b="$2" c="$3"
  shift 3
  while [[ $# -ge 3 ]]; do
    if [[ "$1" == "$a" && "$2" == "$b" && "$3" == "$c" ]]; then
      return 0
    fi
    shift
  done
  return 1
}

# Fast-path for the base profile probe (`--ro-bind / / --dev /dev --proc /proc --die-with-parent -- true`)
# or non-ro-bind modes (`danger-full-access` uses `--bind / /`).
if [[ $# -le 10 && "${*: -1}" == "true" ]] || ! has_arg_seq "--ro-bind" "/" "/" "$@"; then
  exec -a "$0" "$REAL_BWRAP" "$@"
fi

# Pure-bash TOML string parser for top-level keys (e.g. app_data_dir)
parse_toml_root_string() {
  local file="$1" key="$2"
  [[ -r "$file" ]] || return 0
  local line
  while IFS= read -r line; do
    line="${line%%#*}"
    if [[ "$line" =~ ^[[:space:]]*\[([a-zA-Z0-9_.-]+)\][[:space:]]*$ ]]; then
      break
    fi
    if [[ "$line" =~ ^[[:space:]]*${key}[[:space:]]*=[[:space:]]*[\"\']([^\"\']+)[\"\'] ]]; then
      printf "%s\n" "${BASH_REMATCH[1]}"
      return 0
    fi
  done < "$file"
}

# Pure-bash TOML string array parser scoped strictly to a specific [section]
# Supports both single-quoted and double-quoted string items.
parse_toml_array() {
  local file="$1" section="$2" key="$3"
  [[ -r "$file" ]] || return 0
  local current_section="" in_array=0 line rest matched
  while IFS= read -r line; do
    line="${line%%#*}"
    if [[ $in_array -eq 0 ]]; then
      if [[ "$line" =~ ^[[:space:]]*\[([a-zA-Z0-9_.-]+)\][[:space:]]*$ ]]; then
        current_section="${BASH_REMATCH[1]}"
        continue
      fi
      if [[ "$current_section" == "$section" && "$line" =~ ^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\[(.*)$ ]]; then
        in_array=1
        line="${BASH_REMATCH[1]}"
      else
        continue
      fi
    fi
    if [[ $in_array -eq 1 ]]; then
      rest="$line"
      while [[ "$rest" =~ [\"\']([^\"\']+)[\"\'] ]]; do
        matched="${BASH_REMATCH[0]}"
        printf "%s\n" "${BASH_REMATCH[1]}"
        rest="${rest#*"$matched"}"
      done
      if [[ "$rest" == *"]"* ]]; then
        break
      fi
    fi
  done < "$file"
}

# Parse bwrap args before `--` and command argv after `--`
BWRAP_BASE=()
RW_BINDS=()
EXTRA_FLAGS=()
CMD_ARGV=()
AGENT_DIR=""
IN_CMD=0

while [[ $# -gt 0 ]]; do
  if [[ $IN_CMD -eq 1 ]]; then
    CMD_ARGV+=("$1")
    shift
    continue
  fi
  case "$1" in
    --)
      IN_CMD=1
      shift
      ;;
    --ro-bind)
      src="$2"
      dst="$3"
      shift 3
      if [[ "$src" == "/" && "$dst" == "/" ]]; then
        BWRAP_BASE+=("--ro-bind" "/" "/")
      elif [[ "$src" == "/dev/null" && "$dst" == "$HOME_DIR/"* ]]; then
        # Covered by --tmpfs /home/rei whitelist; skip creating ghost file mount
        :
      else
        EXTRA_FLAGS+=("--ro-bind" "$src" "$dst")
      fi
      ;;
    --dev|--proc)
      BWRAP_BASE+=("$1" "$2")
      shift 2
      ;;
    --die-with-parent)
      BWRAP_BASE+=("$1")
      shift
      ;;
    --tmpfs)
      dst="$2"
      shift 2
      if [[ "$dst" == "/tmp" ]]; then
        BWRAP_BASE+=("--tmpfs" "/tmp")
      elif [[ "$dst" == "$HOME_DIR/"* ]]; then
        # Covered by --tmpfs /home/rei whitelist; skip creating ghost dir mount
        :
      else
        EXTRA_FLAGS+=("--tmpfs" "$dst")
      fi
      ;;
    --bind)
      src="$2"
      dst="$3"
      shift 3
      RW_BINDS+=("--bind" "$src" "$dst")
      if [[ "$src" == "$HOME_DIR/.penguin/data/"*"/agents/"*"/scratchpad/"* ]]; then
        AGENT_DIR="${src%/scratchpad/*}"
      fi
      ;;
    --unshare-net)
      EXTRA_FLAGS+=("--unshare-net")
      shift
      ;;
    *)
      EXTRA_FLAGS+=("$1")
      shift
      ;;
  esac
done

# 1. Load [sandbox].allowed_bins from global config.toml (Panic if missing or empty)
if [[ ! -r "$GLOBAL_CONFIG" ]]; then
  echo "[EMA Sandbox Panic] Global config.toml not found at: $GLOBAL_CONFIG" >&2
  exit 1
fi

mapfile -t ALLOWED_BINS < <(parse_toml_array "$GLOBAL_CONFIG" "sandbox" "allowed_bins")
if [[ ${#ALLOWED_BINS[@]} -eq 0 ]]; then
  echo "[EMA Sandbox Panic] Missing or empty [sandbox].allowed_bins in $GLOBAL_CONFIG" >&2
  exit 1
fi

# 2. Load [sandbox].owner_approved_bins from the current session agent's config.toml (if present)
if [[ -n "$AGENT_DIR" && -r "$AGENT_DIR/agent_state/config.toml" ]]; then
  mapfile -t EXTRA_BINS < <(parse_toml_array "$AGENT_DIR/agent_state/config.toml" "sandbox" "owner_approved_bins")
  if [[ ${#EXTRA_BINS[@]} -gt 0 ]]; then
    ALLOWED_BINS+=("${EXTRA_BINS[@]}")
  fi
fi

# 3. Build strict /usr/bin (and /bin -> usr/bin) + helper executable directory whitelist mounts
SYS_BIN_DIRS=(
  "/etc/ssh"
  "/usr/bin"
  "/usr/sbin"
  "/usr/local/bin"
  "/usr/local/sbin"
  "/usr/games"
  "/usr/local/games"
  "/usr/lib/git-core"
  "/usr/lib/openssh"
  "/usr/libexec"
)

BIN_MOUNTS=()
BIN_REMOUNT_RO=()
for d in "${SYS_BIN_DIRS[@]}"; do
  if [[ -d "$d" ]]; then
    BIN_MOUNTS+=("--tmpfs" "$d")
    BIN_REMOUNT_RO+=("--remount-ro" "$d")
  fi
done

HOME_BIN_MOUNTS=()
declare -A SEEN_BINS=()

for bin in "${ALLOWED_BINS[@]}"; do
  [[ -n "$bin" && -z "${SEEN_BINS[$bin]-}" ]] || continue
  SEEN_BINS["$bin"]=1

  if [[ "$bin" == "node" ]]; then
    NODE_BIN="$HOME_DIR/.local/node/bin/node"
    if [[ -e "$NODE_BIN" ]]; then
      BIN_MOUNTS+=("--ro-bind" "$NODE_BIN" "/usr/bin/node")
      HOME_BIN_MOUNTS+=("--ro-bind" "$NODE_BIN" "$NODE_BIN")
    fi
    continue
  fi

  if [[ "$bin" == "penguin" ]]; then
    PENGUIN_BIN="$HOME_DIR/.penguin/data/bin/penguin"
    if [[ -e "$PENGUIN_BIN" ]]; then
      BIN_MOUNTS+=("--ro-bind" "$PENGUIN_BIN" "/usr/bin/penguin")
      HOME_BIN_MOUNTS+=("--ro-bind" "$PENGUIN_BIN" "$PENGUIN_BIN")
    fi
    continue
  fi

  # Search host binary directories in order
  for dir in "/usr/bin" "/usr/local/bin" "/usr/sbin" "$HOME_DIR/.local/bin" "$HOME_DIR/.local/share/pnpm/bin" "$HOME_DIR/.local/go/bin"; do
    cand="$dir/$bin"
    if [[ -L "$cand" ]]; then
      real=$(readlink -f "$cand" || true)
      if [[ -n "$real" && -e "$real" ]]; then
        BIN_MOUNTS+=("--ro-bind" "$real" "/usr/bin/$bin")
        break
      fi
    elif [[ -e "$cand" ]]; then
      BIN_MOUNTS+=("--ro-bind" "$cand" "/usr/bin/$bin")
      break
    fi
  done
done

# 4. Whitelist read-only runtime data/code paths under /home/rei from config.toml
RO_WHITELIST=(
  "$HOME_DIR/.penguin/data/shell-startup"
  "$GLOBAL_CONFIG"
)

if [[ -n "$AGENT_DIR" ]]; then
  RO_WHITELIST+=("$AGENT_DIR/agent_state/config.toml")
fi

# If command explicitly passes `--agent <id>` or `-a <id>`, mount only that agent's non-secret config.toml
APP_DATA_DIR=$(parse_toml_root_string "$GLOBAL_CONFIG" "app_data_dir" || true)
if [[ -n "$APP_DATA_DIR" && "${CMD_ARGV[*]}" =~ (--agent|-a)[[:space:]]+([a-zA-Z0-9_-]+) ]]; then
  TARGET_AGENT_CFG="$APP_DATA_DIR/agents/${BASH_REMATCH[2]}/agent_state/config.toml"
  RO_WHITELIST+=("$TARGET_AGENT_CFG")
fi

mapfile -t EXTRA_RO_PATHS < <(parse_toml_array "$GLOBAL_CONFIG" "sandbox" "ro_paths")
if [[ ${#EXTRA_RO_PATHS[@]} -gt 0 ]]; then
  RO_WHITELIST+=("${EXTRA_RO_PATHS[@]}")
fi

RO_ARGS=("--ro-bind" "$SANDBOX_PROFILE" "$HOME_DIR/.profile")
for p in "${RO_WHITELIST[@]}"; do
  [[ -n "$p" ]] && RO_ARGS+=("--ro-bind-try" "$p" "$p")
done

FINAL_ARGS=(
  "${BWRAP_BASE[@]}"
  "${BIN_MOUNTS[@]}"
  "${BIN_REMOUNT_RO[@]}"
  "--tmpfs" "$HOME_DIR"
  "${HOME_BIN_MOUNTS[@]}"
  "${RO_ARGS[@]}"
  "${RW_BINDS[@]}"
  "${EXTRA_FLAGS[@]}"
  "--remount-ro" "$HOME_DIR"
  "--"
  "${CMD_ARGV[@]}"
)

exec -a "$0" "$REAL_BWRAP" "${FINAL_ARGS[@]}"
