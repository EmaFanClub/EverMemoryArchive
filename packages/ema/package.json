{
  "name": "@prism-shadow/ema",
  "version": "0.1.0",
  "description": "EverMemoryArchive core system prompt configuration for creating EMA companion agents or installing personality features into existing Penguin agents.",
  "author": "Ema Fan Club",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prompts": {
      "types": "./dist/prompts/index.d.ts",
      "default": "./dist/prompts/index.js"
    }
  },
  "bin": {
    "ema": "./bin/ema.js"
  },
  "files": [
    "dist",
    "bin",
    "workbenches",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prismshadow/penguin-core": "^0.2.18",
    "fast-xml-parser": "^5.12.0",
    "hono": "^4.13.16",
    "playwright": "^1.65.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/qrcode-terminal": "^0.12.2",
    "qrcode-terminal": "^0.12.0"
  }
}
